root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{js,jsx,mjs,cjs}]
quote_type = single
semi = false
jsx_single_quote = true
trailing_comma = all
print_width = 100

[*.css]
indent_size = 2
